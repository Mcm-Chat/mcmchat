# Konfigurasi Firebase Web untuk push notification browser/PWA.
# Semua nilai di bawah BERSIFAT PUBLIK (bukan secret) dan diambil dari
# Firebase Console → Project settings:
#   - General → Your apps → Web app (</>) → SDK setup and configuration
#   - Cloud Messaging → Web configuration → Web Push certificates (Key pair)
VITE_FCM_API_KEY=
VITE_FCM_PROJECT_ID=
VITE_FCM_SENDER_ID=
VITE_FCM_APP_ID=
VITE_FCM_VAPID_KEY=
